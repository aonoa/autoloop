{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-autoloop:protocol:v1",
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "subject": {
          "type": ["string", "null"],
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9#._:\\/@-]*$"
        },
        "summary": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "detail": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "link": {
          "type": ["string", "null"],
          "maxLength": 500,
          "pattern": "^(https?://[\\x21-\\x7e]+)?$"
        },
        "hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actor": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9#._:\\/@-]*$"
        },
        "reply": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^qq-(private|group)-[1-9][0-9]*$"
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      },
      "required": ["id", "type"],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "ask": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 2,
          "maxItems": 5
        },
        "recommend": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "about": {
          "type": "string",
          "maxLength": 4000
        },
        "key": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": ["title", "text", "options"],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2
            },
            "recommend": {
              "type": "integer",
              "maximum": 1
            }
          }
        },
        {
          "properties": {
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3
            },
            "recommend": {
              "type": "integer",
              "maximum": 2
            }
          }
        },
        {
          "properties": {
            "options": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4
            },
            "recommend": {
              "type": "integer",
              "maximum": 3
            }
          }
        },
        {
          "properties": {
            "options": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5
            },
            "recommend": {
              "type": "integer",
              "maximum": 4
            }
          }
        }
      ]
    },
    "notice": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "key": {
          "type": "string",
          "maxLength": 100
        },
        "fyi": {
          "type": "boolean"
        }
      },
      "required": ["title", "text"],
      "additionalProperties": false
    },
    "resolve": {
      "type": "object",
      "properties": {
        "card": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": ["card", "reason"],
      "additionalProperties": false
    },
    "later": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S"
            },
            "cancel": {
              "const": true
            },
            "about": {}
          },
          "required": ["key", "cancel"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
            },
            "about": {
              "type": "string",
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": ["key", "at", "about"],
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": ["done", "nothing", "failed", "cancelled"]
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "error": {
          "type": "string",
          "maxLength": 500
        },
        "session": {
          "type": "string",
          "maxLength": 500
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "ask": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ask"
          },
          "maxItems": 5
        },
        "notice": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notice"
          },
          "maxItems": 10
        },
        "resolve": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolve"
          },
          "maxItems": 50
        },
        "later": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/later"
          },
          "maxItems": 10
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "maxItems": 100
        },
        "report": {
          "type": "object",
          "properties": {
            "state": {
              "enum": ["progress", "waiting", "ready", "blocked", "failed", "dropped"]
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": ["state"],
          "additionalProperties": false
        },
        "verdict": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": ["accept", "stop", "ignore", "unavailable"]
            },
            "reason": {
              "type": "string",
              "maxLength": 1000
            },
            "strength": {
              "enum": ["explicit", "inferred"]
            },
            "scope": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": ["decision"],
          "additionalProperties": false
        },
        "route": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "\\S"
            },
            "session": {
              "enum": ["continue", "new", "ask"]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reason": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": ["project", "session", "confidence"],
          "additionalProperties": false
        },
        "create": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "description": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cwd": {
              "type": "string",
              "maxLength": 300
            },
            "agent": {
              "type": "string",
              "maxLength": 100
            },
            "worker": {
              "type": "string",
              "maxLength": 100
            },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          },
          "required": ["project", "description", "confidence"],
          "additionalProperties": false
        }
      },
      "required": ["outcome"],
      "additionalProperties": false
    },
    "started": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "maxLength": 500
        },
        "link": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "progress": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "step": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S"
        },
        "detail": {
          "type": "string",
          "maxLength": 4000
        },
        "kind": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": ["step"],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "choice": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "by": {
          "type": "string",
          "maxLength": 500
        },
        "ref": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "delivered": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "ref": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      },
      "required": ["version"],
      "additionalProperties": false
    },
    "failed": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "error": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": ["version", "error"],
      "additionalProperties": false
    },
    "tell-source": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "text": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": ["key", "text"],
      "additionalProperties": false
    },
    "tell-worker": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "text": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "task": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": ["key", "text", "task"],
      "additionalProperties": false
    },
    "ask-worker": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "ask": {
          "$ref": "#/$defs/ask"
        }
      },
      "required": ["task", "ask"],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "run": {
          "type": "integer",
          "minimum": 1
        },
        "token": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S"
        },
        "rule": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "skill": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "emits": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["source", "types"],
              "additionalProperties": true
            }
          },
          "required": ["name", "cwd"],
          "additionalProperties": true
        },
        "agent": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "use": {
              "type": "string"
            },
            "worker": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "effort": {
              "type": "string"
            },
            "tier": {
              "type": "string"
            },
            "access": {
              "enum": ["read", "edit", "full"]
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "program": {
              "type": "string"
            },
            "timeout": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["id", "name", "use", "access"],
          "additionalProperties": true
        },
        "context": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/context-event"
              }
            },
            "answers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/context-answer"
              }
            },
            "timers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/context-timer"
              }
            },
            "waiting": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/context-timer"
              }
            },
            "open": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/context-open"
              }
            },
            "decided": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/context-decided"
              }
            },
            "dispatch": {
              "type": "object",
              "properties": {
                "minConfidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "create": {
                  "type": "boolean"
                },
                "workers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "projects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "project": {
                        "type": "string"
                      },
                      "rule": {
                        "type": "string"
                      },
                      "cwd": {
                        "type": "string"
                      },
                      "agent": {
                        "type": "string"
                      },
                      "worker": {
                        "type": "string"
                      },
                      "online": {
                        "type": "boolean"
                      },
                      "subjects": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "aliases": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "description": {
                        "type": "string"
                      },
                      "lastRun": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "lastSession": {
                        "type": ["string", "null"]
                      },
                      "lastState": {
                        "type": "string"
                      },
                      "lastSummary": {
                        "type": ["string", "null"]
                      },
                      "canContinue": {
                        "type": "boolean"
                      },
                      "lastDispatch": {
                        "type": "object",
                        "properties": {
                          "run": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "reason": {
                            "type": "string"
                          },
                          "at": {
                            "type": "string"
                          }
                        },
                        "required": ["run", "confidence", "reason", "at"],
                        "additionalProperties": false
                      },
                      "preferences": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string"
                            },
                            "actor": {
                              "type": "string"
                            },
                            "reason": {
                              "type": "string"
                            },
                            "confirmations": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": ["source", "actor", "reason", "confirmations"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "project",
                      "rule",
                      "cwd",
                      "agent",
                      "worker",
                      "online",
                      "subjects",
                      "aliases",
                      "description",
                      "canContinue",
                      "preferences"
                    ],
                    "additionalProperties": false
                  }
                },
                "matters": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "project": {
                        "type": "string"
                      },
                      "rule": {
                        "type": "string"
                      },
                      "lane": {
                        "type": "string"
                      },
                      "stage": {
                        "type": "string"
                      },
                      "lastRun": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": ["rule", "lane", "stage", "lastRun"],
                    "additionalProperties": false
                  }
                },
                "recentRuns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "run": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "project": {
                        "type": "string"
                      },
                      "rule": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "at": {
                        "type": ["string", "null"]
                      }
                    },
                    "required": ["run", "rule", "state", "summary", "at"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["minConfidence", "create", "workers", "projects", "matters", "recentRuns"],
              "additionalProperties": false
            }
          },
          "required": ["events", "answers", "timers", "waiting", "open", "decided"],
          "additionalProperties": true
        },
        "session": {
          "type": ["string", "null"]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": ["assess", "speculate", "dispatch"]
        },
        "askFirst": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": {
          "enum": ["im", "async"]
        },
        "thread": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 300
            },
            "rule": {
              "type": "string",
              "maxLength": 200
            },
            "lane": {
              "type": "string",
              "maxLength": 100
            },
            "project": {
              "type": "string",
              "maxLength": 100
            },
            "rounds": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "properties": {
                  "run": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "at": {
                    "type": ["string", "null"]
                  }
                },
                "required": ["run", "state", "summary", "at"],
                "additionalProperties": false
              }
            },
            "related": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "lane": {
                    "type": "string"
                  },
                  "stage": {
                    "type": "string"
                  }
                },
                "required": ["rule", "lane", "stage"],
                "additionalProperties": false
              }
            }
          },
          "required": ["id", "rule", "lane", "rounds", "related"],
          "additionalProperties": false
        }
      },
      "required": ["run", "token", "attempt", "rule", "agent", "session", "askFirst", "context"],
      "additionalProperties": true
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": ["ask", "notice"]
        },
        "state": {
          "enum": ["open", "decided", "done", "closed"]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ref": {
          "type": ["string", "null"]
        },
        "recommend": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "choice": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "answer": {
          "type": ["string", "null"]
        },
        "by": {
          "type": ["string", "null"]
        },
        "result": {
          "type": ["string", "null"]
        },
        "link": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "state",
        "title",
        "text",
        "options",
        "ref",
        "recommend",
        "choice",
        "answer",
        "by",
        "result",
        "link"
      ],
      "additionalProperties": true,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "ask"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "notice"
            }
          }
        }
      ]
    },
    "work": {
      "type": "object",
      "properties": {
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/job"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": ["job", "cancel"],
      "additionalProperties": false
    },
    "eventAck": {
      "type": "object",
      "properties": {
        "event": {
          "type": "integer",
          "minimum": 1
        },
        "duplicate": {
          "type": "boolean"
        },
        "routed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "paused": {
          "description": "Rules that match the event but are paused, so it was recorded for them and not dispatched.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "refused": {
          "description": "Rules a policy refused: recorded for them, not dispatched.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "dispatch": {
          "type": "object",
          "properties": {
            "state": {
              "enum": ["queued", "running", "creating", "placed", "unassigned", "replied", "failed"]
            },
            "run": {
              "type": "integer",
              "minimum": 1
            },
            "project": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": ["state"],
          "additionalProperties": false
        },
        "pending": {
          "type": "boolean"
        }
      },
      "required": ["event", "duplicate", "routed"],
      "additionalProperties": false
    },
    "eventOutcome": {
      "description": "What became of an event, read with the key of the source that sent it.",
      "type": "object",
      "properties": {
        "event": {
          "type": "integer",
          "minimum": 1
        },
        "routed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "paused": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "refused": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "dispatch": {
          "$ref": "#/$defs/eventAck/properties/dispatch"
        },
        "pending": {
          "type": "boolean"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run": {
                "type": "integer",
                "minimum": 1
              },
              "rule": {
                "type": "string",
                "maxLength": 200
              },
              "state": {
                "enum": ["queued", "claimed", "unknown", "done", "nothing", "cancelled"]
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              },
              "error": {
                "type": ["string", "null"]
              },
              "finishedAt": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  }
                ]
              },
              "summary": {
                "description": "Null until it ends, and whenever the run also took another source's events.",
                "type": ["string", "null"]
              },
              "events": {
                "description": "What its receipt sent; null whenever the run also took another source's events.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/event"
                    }
                  }
                ]
              }
            },
            "required": ["run", "rule", "state", "attempts", "error", "finishedAt", "summary", "events"],
            "additionalProperties": false
          }
        }
      },
      "required": ["event", "routed", "paused", "runs"],
      "additionalProperties": false
    },
    "receiptAck": {
      "type": "object",
      "properties": {
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "card": {
                "type": "integer",
                "minimum": 1
              },
              "what": {
                "type": "string",
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": ["reason"],
            "additionalProperties": false
          }
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": ["rejected"],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "maxLength": 100
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "maxLength": 100
              },
              "key": {
                "type": "string",
                "maxLength": 500
              },
              "row": {
                "type": ["object", "null"]
              }
            },
            "required": ["table", "key", "row"],
            "additionalProperties": false
          }
        }
      },
      "required": ["version", "seq", "at", "type", "changes"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": ["error"],
      "additionalProperties": false
    },
    "context-event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sourceName": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "receivedAt": {
          "type": "string"
        },
        "hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      },
      "required": ["id", "source", "sourceName", "type", "subject", "summary", "detail", "link", "receivedAt"],
      "additionalProperties": true
    },
    "context-answer": {
      "type": "object",
      "properties": {
        "card": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choice": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "chosen": {
          "type": ["string", "null"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "about": {
          "type": "string"
        },
        "by": {
          "type": ["string", "null"]
        },
        "at": {
          "type": "string"
        }
      },
      "required": ["card", "title", "options", "choice", "chosen", "text", "about", "by", "at"],
      "additionalProperties": true
    },
    "context-timer": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "about": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": ["key", "about", "at"],
      "additionalProperties": true
    },
    "context-open": {
      "type": "object",
      "properties": {
        "card": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": ["card", "title", "text", "at"],
      "additionalProperties": true
    },
    "context-decided": {
      "type": "object",
      "properties": {
        "card": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "choice": {
          "type": ["string", "null"]
        },
        "at": {
          "type": "string"
        }
      },
      "required": ["card", "title", "choice", "at"],
      "additionalProperties": true
    },
    "attachment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^att_[0-9a-f]{16}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^/\\\\\\\\\\u0000-\\u001f\\u007f]+\\.(png|jpe?g|webp|gif)$"
        },
        "mediaType": {
          "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25165824
        }
      },
      "required": ["id", "name", "mediaType", "size"],
      "additionalProperties": false
    }
  }
}
